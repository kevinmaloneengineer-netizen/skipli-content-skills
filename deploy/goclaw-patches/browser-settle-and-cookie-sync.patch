diff --git a/pkg/browser/browser_settle_test.go b/pkg/browser/browser_settle_test.go
new file mode 100644
index 00000000..0e8518bb
--- /dev/null
+++ b/pkg/browser/browser_settle_test.go
@@ -0,0 +1,88 @@
+package browser
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+// busyPageURL serves a page whose DOM mutates every 100ms forever, like a live
+// social feed. WaitStable never succeeds on it.
+const busyPageURL = "data:text/html,<body><div id=t>0</div><script>setInterval(()=>{const d=document.getElementById('t');d.textContent=String(+d.textContent+1);document.body.appendChild(document.createElement('span'))},100)</script></body>"
+
+// remoteChromeForTest returns a CDP URL from GOCLAW_TEST_CHROME_URL
+// (e.g. ws://localhost:9222), or skips: these tests need a real Chrome.
+func remoteChromeForTest(t *testing.T) string {
+	t.Helper()
+	u := os.Getenv("GOCLAW_TEST_CHROME_URL")
+	if u == "" {
+		t.Skip("GOCLAW_TEST_CHROME_URL not set; skipping real-Chrome test")
+	}
+	return u
+}
+
+// Regression: OpenTab on a never-settling page used to block until the action
+// ctx expired, the watchdog then closed the page, and OpenTab still returned
+// success - so the next Evaluate failed with "context canceled".
+func TestOpenTabNeverSettlingPageStaysUsable(t *testing.T) {
+	m := New(WithRemoteURL(remoteChromeForTest(t)))
+	defer m.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 45*time.Second)
+	defer cancel()
+	if err := m.Start(ctx); err != nil {
+		t.Fatalf("start: %v", err)
+	}
+
+	start := time.Now()
+	tab, err := m.OpenTab(ctx, busyPageURL)
+	elapsed := time.Since(start)
+	if err != nil {
+		t.Fatalf("open busy page: %v", err)
+	}
+	if elapsed > stableWaitMax+5*time.Second {
+		t.Fatalf("OpenTab took %s, want <= ~%s (stability wait must be capped)", elapsed, stableWaitMax)
+	}
+
+	// Simulate the tool handler: the per-action ctx is cancelled after open returns.
+	cancel()
+	time.Sleep(200 * time.Millisecond)
+
+	got, err := m.Evaluate(context.Background(), tab.TargetID, `() => document.getElementById('t') ? "alive" : "missing"`)
+	if err != nil {
+		t.Fatalf("evaluate after open: %v", err)
+	}
+	if !strings.Contains(got, "alive") {
+		t.Fatalf("evaluate = %q, want alive", got)
+	}
+}
+
+// waitSettled must never outlive the caller's ctx and must leave headroom
+// before the deadline so the watchdog does not fire on the normal path.
+func TestWaitSettledRespectsShortDeadline(t *testing.T) {
+	m := New(WithRemoteURL(remoteChromeForTest(t)))
+	defer m.Close()
+
+	if err := m.Start(context.Background()); err != nil {
+		t.Fatalf("start: %v", err)
+	}
+	tab, err := m.OpenTab(context.Background(), busyPageURL)
+	if err != nil {
+		t.Fatalf("open: %v", err)
+	}
+	m.mu.Lock()
+	page := m.pages[tab.TargetID]
+	m.mu.Unlock()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+	defer cancel()
+	start := time.Now()
+	if err := waitSettled(ctx, page); err != nil {
+		t.Fatalf("waitSettled on busy page with live ctx: %v", err)
+	}
+	if elapsed := time.Since(start); elapsed > 3*time.Second {
+		t.Fatalf("waitSettled took %s, want about half of the 4s deadline", elapsed)
+	}
+}
