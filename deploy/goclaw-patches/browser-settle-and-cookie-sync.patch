+// stableWaitMax bounds how long open/navigate/actions wait for the DOM to settle.
+// Live sites (social feeds, chat apps) mutate the DOM continuously and never
+// become "stable". Unbounded, the wait ran until the action timeout; the ctx
+// watchdog then closed the page while OpenTab still reported success, so the
+// next action on that tab failed with "context canceled".
+const stableWaitMax = 10 * time.Second
+
+// waitSettled waits, best effort, for the page DOM to settle. The wait is
+// capped at stableWaitMax (or half the time left on ctx, whichever is shorter)
+// so a page that never settles is left open and usable. It returns ctx.Err()
+// when the caller's ctx is done, or the wait error for real failures such as a
+// closed target.
+func waitSettled(ctx context.Context, page *rod.Page) error {
+	budget := stableWaitMax
+	if deadline, ok := ctx.Deadline(); ok {
+		if half := time.Until(deadline) / 2; half < budget {
+			budget = half
+		}
+	}
+	if budget > 0 {
+		timed := page.Timeout(budget)
+		err := timed.WaitStable(300 * time.Millisecond)
+		timed.CancelTimeout()
+		if err != nil && !errors.Is(err, context.DeadlineExceeded) && ctx.Err() == nil {
+			return err
+		}
+	}
+	return ctx.Err()
+}
+
 // Close shuts down the browser if running.
 func (m *Manager) Close() error {
 	return m.Stop(context.Background())
