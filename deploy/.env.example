# Copy to deploy/.env (gitignored). Generate secrets with: openssl rand -hex 32
GOCLAW_GATEWAY_TOKEN=
GOCLAW_ENCRYPTION_KEY=

# Patched build until the browser fix is merged upstream (see deploy/README.md)
GOCLAW_IMAGE=skipli/goclaw:patched
GOCLAW_PORT=18790

POSTGRES_PASSWORD=goclaw

# Used by scripts/push-skills.sh, examples/call-agent.ts and web/ (outside Docker)
GOCLAW_URL=http://localhost:18790
GOCLAW_USER_ID=system
# Agent UUIDs (not agent_key) to grant uploaded skills to, comma-separated
GOCLAW_AGENT_IDS=

# Web UI (web/)
# Public domain for HTTPS (docker compose --profile https up -d); its DNS A record must point at the server.
DOMAIN=
WEB_PORT=3000
# 127.0.0.1 = this machine only. Use 0.0.0.0 to expose - then APP_PASSWORD is a must.
WEB_BIND=127.0.0.1
APP_PASSWORD=
# One login per customer instead of the shared APP_PASSWORD (1 = on). The first account is the admin:
# created on the web's setup screen, or from ADMIN_EMAIL / ADMIN_PASSWORD when no account exists yet.
ACCOUNTS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs the login cookies; leave empty to generate one in the data folder.
SESSION_SECRET=
# Runs per customer per day (the admin can change it per account).
USER_DAILY_JOB_LIMIT=30
# With ACCOUNTS=1: customers create their own account (1 = on), start with TRIAL_CREDITS and buy
# more through Stripe Checkout. Packs are credits:price in cents. See deploy/README.md, section 3c.
SIGNUP=
TRIAL_CREDITS=20
# Trial accounts one IP address may create (0 = no cap, the default; the admin page can change it).
SIGNUP_PER_IP=0
# Which proxies are believed about the visitor's IP. loopback,uniquelocal = the Caddy service (or nginx on
# this machine) only, so nobody can fake their IP by reaching the web port directly. Set 2 when Cloudflare's
# proxy (orange cloud) is also in front.
TRUST_PROXY=loopback,uniquelocal
# Self sign-ups the whole server takes per hour (not per IP: an office shares one), guards the mail quota.
SIGNUP_PER_HOUR=60
# Runs for the whole app per day (guards the AI quota), and per IP per hour (0 = off; an office shares one IP).
DAILY_JOB_LIMIT=500
JOB_LIMIT_PER_IP_HOUR=0
# Scans GoClaw runs at once (each opens Chrome). 2 fits a 4 vCPU / 8 GB server.
JOB_CONCURRENCY=2
# Sign-up and forgot-password codes by email: a Gmail address and its App Password (Google Account →
# Security → 2-Step Verification → App passwords). Empty = new accounts skip the code. MAIL_LOG=1 prints
# the mails in the server log instead (local testing).
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_LOG=
# Errors (server, failed jobs, browser) are listed on the admin page; this Slack / Discord incoming
# webhook also gets them (the same error at most every 10 minutes).
ERROR_WEBHOOK_URL=
# Daily database backup to the storage bucket (needs STORAGE_*), backups/YYYY-MM-DD.json.gz.
BACKUP_KEEP_DAYS=14
# On stop, seconds to let running jobs finish (one still running starts over on the next boot).
SHUTDOWN_WAIT_SEC=25
# Heavy runs (video, AI image, photo fix, reel cut, dub) one account may have going at once; 0 = no limit.
# The admin page can change it.
HEAVY_PER_USER=2
# Rough model price for the admin money page, USD per 1M tokens (input and output blended).
COST_TOKEN_USD_PER_M=0.5
CREDIT_PACKS=100:900,300:2400,1000:6900
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# The web's public address (https://<DOMAIN>), for Stripe's return links and the public menu links.
PUBLIC_URL=
AGENT_SCOUT=content-scout
AGENT_WRITER=content-writer

# Firestore (web/). Project ID + a service account with role "Cloud Datastore User".
FIREBASE_PROJECT_ID=
# Whole service-account JSON on one line, e.g. FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
# (or leave empty and set GOOGLE_APPLICATION_CREDENTIALS=/path/key.json when running outside Docker)
FIREBASE_SERVICE_ACCOUNT=
# Non-default database id; empty = (default)
FIRESTORE_DATABASE_ID=
# Collection prefix so this can share a project with the main Skipli app
FIRESTORE_PREFIX=content_

# OPTIONAL backup for the Facebook "100 latest reels" scan. The default is free (the skill pages
# the public reels tab logged-out). With a token the server gets the reel list from Apify instead.
# Token: console.apify.com → Settings → API & Integrations.
APIFY_TOKEN=
APIFY_FB_REELS_ACTOR=apify~facebook-reels-scraper
# Reuse a channel's reel list for this many hours (several users scanning the same competitor = one paid call)
REEL_LIST_CACHE_HOURS=6

# Free AI path: Groq writes posts and reports, Gemini watches videos and draws images.
GROQ_API_KEY=
GEMINI_API_KEY=
# Google Maps reviews through Apify (paid per review).
APIFY_REVIEWS_TOKEN=

# Files (AI images, videos, uploads) and the daily backup on Cloudflare R2 / any S3 store. See deploy/README.md, 3b.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto

# GPU video worker (video-worker/). Can also be set on the admin page.
VIDEO_WORKER_URL=
VIDEO_WORKER_TOKEN=
